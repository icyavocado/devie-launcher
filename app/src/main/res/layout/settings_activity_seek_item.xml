        <TextView android:textAppearance="@style/SettingsItemTextAppearance" android:id="@id/label" android:layout_width="fill_parent" android:layout_height="wrap_content" />
        <com.ovacoda.devie.widget.DiscreteSeekBar android:id="@id/seek_bar" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="6.0dip" />
    </LinearLayout>
